{
  "meta": {
    "lastTouchedVersion": "2026.5.6",
    "lastTouchedAt": "2026-05-07T00:00:00.000Z"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-haiku-4-5-20251001",
        "fallbacks": ["groq/llama-3.1-8b-instant"]
      },
      "workspace": "/app/workspace",
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": false
      }
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "groupAllowFrom": ["8572521981"],
      "allowFrom": ["8572521981"],
      "groups": {
        "*": {
          "requireMention": false
        }
      },
      "groupPolicy": "allowlist"
    },
    "discord": {
      "enabled": false,
      "groupPolicy": "allowlist"
    },
    "slack": {
      "mode": "socket",
      "webhookPath": "/slack/events",
      "enabled": false,
      "userTokenReadOnly": true,
      "groupPolicy": "allowlist"
    }
  },
  "gateway": {
    "port": 8080,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": ["https://clawrunner-production.up.railway.app"],
      "dangerouslyDisableDeviceAuth": true
    },
    "trustedProxies": ["100.64.0.0/10"],
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "calendar.add",
        "contacts.add",
        "reminders.add"
      ]
    }
  },
  "skills": {
    "entries": {
      "github": {
        "enabled": false
      },
      "notion-api-integration": {
        "enabled": false
      },
      "ai-core": {
        "enabled": false
      }
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "discord": {
        "enabled": false
      },
      "slack": {
        "enabled": false
      },
      "device-pair": {
        "enabled": false
      },
      "browser": {
        "enabled": false
      },
      "phone-control": {
        "enabled": false
      },
      "talk-voice": {
        "enabled": false
      },
      "memory-core": {
        "enabled": false
      },
      "file-transfer": {
        "enabled": false
      }
    }
  }
}
